# ===========================================
# UITraps Unified Platform - Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# ===========================================

# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Path to your local copy of the UI Tenets & Traps book source.
# Used to build the knowledge base for Pass 2 analysis enrichment.
# Windows example:  BOOK_SOURCE_PATH=C:/Users/yourname/Documents/book manuscript.pdf
# Mac/Linux example: BOOK_SOURCE_PATH=/Users/yourname/Documents/book manuscript.pdf
BOOK_SOURCE_PATH=C:\path\to\book manuscript.pdf

# ── Local Development ──────────────────────────────────────────────────────────

# Bypasses JWT auth and subscription checks for local testing.
# Set to true when running locally; remove or set to false in production.
DEV_MODE=true

# ── Auth ───────────────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens. Must be at least 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# Must match the JWT_SECRET set in WordPress wp-config.php in production.
JWT_SECRET=your-32-char-minimum-secret-here

# ── Optional ──────────────────────────────────────────────────────────────────

# Comma-separated valid API keys for the legacy /analyze endpoints.
# Not needed when using DEV_MODE=true or JWT auth via /api/ask.
# VALID_API_KEYS=

# Monthly analysis limit per API key (default: 20)
# MONTHLY_LIMIT=20

# Figma personal access token — only needed for Figma design analysis.
# Get one at https://www.figma.com/settings under "Personal access tokens".
# FIGMA_TOKEN=figd_...

# Shared secret for WooCommerce webhook calls (must match WordPress env var).
# WEBHOOK_SECRET=

# Server port (default: 8000)
# PORT=8000

# Database URL (default: local SQLite file uitraps.db)
# DATABASE_URL=sqlite:///./usage.db

# Additional allowed CORS origins beyond localhost (comma-separated)
# ALLOWED_ORIGINS=https://uitraps.com,https://www.uitraps.com

# AI model overrides — only change if you know what you're doing
# CHAT_AI_MODEL=claude-opus-4-8
# CHAT_MAX_TOKENS=1024
# CHAT_TEMPERATURE=0.7  (ignored on Opus 4.7/4.8, Sonnet 5, Fable 5 — they reject sampling params)

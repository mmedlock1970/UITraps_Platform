# ===========================================
# UITraps Unified Platform - Environment Variables
# ===========================================

# --- Existing: Trap Analysis ---
ANTHROPIC_API_KEY=sk-ant-...
VALID_API_KEYS=                          # Comma-separated. Leave empty for dev mode
MONTHLY_LIMIT=20
ALLOWED_ORIGINS=https://uitraps.com,https://www.uitraps.com,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# --- NEW: RAG Chat ---
OPENAI_API_KEY=sk-...                    # For embeddings (text-embedding-3-small)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=uitraps-content
PINECONE_TOP_K=5                          # Number of chunks to retrieve

# --- NEW: JWT Auth (must match WordPress wp-config.php) ---
JWT_SECRET=your-32-char-minimum-secret

# --- NEW: Chat AI Config ---
CHAT_AI_MODEL=claude-sonnet-4-5-20250929
CHAT_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.7
MAX_CHAT_REQUESTS_PER_HOUR=50

# --- Book Manuscript Source (required for Pass 2 enrichment) ---
# The backend downloads the book PDF from Drive automatically and re-checks every
# BOOK_SYNC_INTERVAL_HOURS (default 24). Both Steve and Michael use the same URL.
BOOK_SOURCE_URL=https://drive.google.com/file/d/10vuO07k0nCH2TbeMVXvpQ04OLATfuLxk/view?usp=sharing
BOOK_SYNC_INTERVAL_HOURS=24
# Alternative: point to a local PDF if you prefer not to use Drive:
# BOOK_SOURCE_PATH=C:\path\to\book manuscript.pdf

# --- Optional ---
DEV_MODE=true
# PORT=8000
# DATABASE_URL=sqlite:///./usage.db
# DEBUG_SQL=false
